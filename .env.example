# ============================================
# DATABASE (Prisma 7)
# ============================================
DATABASE_URL="postgresql://suamesa:suamesa_dev@localhost:5432/suamesa_dev?schema=public"

# ============================================
# BACKEND (NestJS)
# ============================================
PORT=3001
NODE_ENV=development
API_URL="http://192.168.101.15:3001"
FRONTEND_URL="http://192.168.101.15:3000"
ALLOWED_ORIGINS="http://192.168.101.15:3000,http://localhost:3000,http://restaurante.localhost:3000"

# ============================================
# JWT (Authentication)
# ============================================
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-this-in-production"
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# ============================================
# REDIS (Cache & Sessions)
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_DB=0

# ============================================
# FRONTEND (Next.js)
# ============================================
NEXT_PUBLIC_API_URL="http://192.168.101.15:3001/api"
NEXT_PUBLIC_WS_URL="ws://192.168.101.15:3001"

# ============================================
# EMAIL (Optional - SMTP)
# ============================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@suamesa.app.br"

# ============================================
# SUPABASE (Optional - File Storage)
# ============================================
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="debug"
